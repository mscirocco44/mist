version: "3.8"
services:
  prometheus:
    image: prom/prometheus:latest
    volumes:
      - ./prometheus:/etc/prometheus
    ports:
      - "9090:9090"
  grafana:
    image: grafana/grafana:latest
    volumes:
      - ./grafana:/var/lib/grafana
    ports:
      - "3000:3000"
  loki:
    image: grafana/loki:2.8.2
    volumes:
      - ./loki:/etc/loki
    ports:
      - "3100:3100"
  tempo:
    image: grafana/tempo:1.5.0
    volumes:
      - ./tempo:/etc/tempo
    ports:
      - "3200:3200"
      - "4317:4317"
